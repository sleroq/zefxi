# Copy to .env and fill in the bot credentials and chat/channel IDs.
export TELEGRAM_TOKEN=""
export TELEGRAM_CHAT_ID=""
export DISCORD_TOKEN=""
export DISCORD_SERVER=""
export DISCORD_CHANNEL=""

# Optional: default is zefxi.db in the working directory.
export SQLITE_PATH="zefxi.db"
# Optional: Discord's default upload limit is 20 MiB.
export DISCORD_MAX_UPLOAD_MIB="20"
